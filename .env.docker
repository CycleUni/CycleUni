# UniBooks 本地 Docker 開發環境變數
# 所有服務共用此檔；各服務的 docker-compose 會從此檔讀取所需變數
# =====================================================================

# ---- Django backend (UniBooks-BE) ----
SECRET_KEY=docker-dev-secret-key-change-in-production-abc123
JWT_SIGNING_KEY=docker-dev-jwt-signing-key-change-in-production
GOOGLE_BOOKS_API_KEY=dummy-google-books-api-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# PostgreSQL
POSTGRES_DATABASE=unibooks
POSTGRES_USER=unibooks
POSTGRES_PASSWORD=unibooks
POSTGRES_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# CFEdgeChat integration — see the shared-secret block at the bottom of this
# file for EDGE_CHAT_JWT_SECRET and the webhook secret.
# EDGE_CHAT_URL is what the Django backend returns to the frontend for the
# browser to open a WebSocket to. It must be reachable from the browser
# (use localhost / host.docker.internal here, NOT the docker-internal hostname).
EDGE_CHAT_URL=http://localhost:8787
EDGE_CHAT_APP_ID=unibooks

# ISBNnet Resolver integration (Cloudflare Worker microservice: exact-ISBN
# lookup for the National Central Library search engine option). Points at
# the isbnnet-resolver docker-compose service, not localhost — see the
# comment on EDGE_CHAT_URL above for why that distinction matters.
ISBNNET_RESOLVER_URL=http://isbnnet-resolver:8789

# Google OAuth
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Mailjet (console backend in dev)
DEFAULT_FROM_EMAIL=noreply@localhost
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# R2 storage (local filesystem in dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Default superuser
DEFAULT_SUPERUSER_EMAIL=admin@unibooks.com
DEFAULT_SUPERUSER_PASSWORD=admin123
DEFAULT_SUPERUSER_FIRST_NAME=Admin

# Cron secret
CRON_SECRET=docker-dev-cron-secret

# ---- UniBooks-FE ----
NG_APP_BACKEND_URL=http://localhost:8000/api/v1

# ---- CFEdgeChat ----
# 這些變數對應到 CFEdgeChat 的 .dev.vars
DJANGO_WEBHOOK_URL=http://backend:8000/api/v1/messaging/webhook/edge-chat/
ENVIRONMENT=development
# 圖片訊息允許指向的主機（逗號分隔）。留空＝允許任何 https 主機，本機開發用；
# production 必須填 R2 的公開網域（即 R2_PUBLIC_URL 的 host），否則聊天室的
# 圖片訊息可以指向任意伺服器，變成對方的追蹤像素。見 ChatRoom.isImageUrlAllowed。
ALLOWED_IMAGE_HOSTS=
APP_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# ---- Django 與 CFEdgeChat 共用的密鑰 ----
# 兩邊都從這一個檔案讀取，所以每個密鑰只能在這裡出現一次。
#
# EDGE_CHAT_JWT_SECRET 原本在上下兩段各寫了一次、值還不一樣；能動只是因為
# 後面那份覆蓋掉前面那份，兩邊才碰巧拿到同一個值。
#
# webhook 密鑰更糟：Django 讀 EDGE_CHAT_WEBHOOK_SECRET、Worker 讀
# DJANGO_WEBHOOK_SECRET，名字不同就不會互相覆蓋，而兩份的值本來是不一樣的
# ——離線訊息 webhook 因此一直被 Django 以 403 擋掉，而且是靜默失敗。
# 這是同一個共用密鑰的兩個名字，值必須一致。
EDGE_CHAT_JWT_SECRET=docker-dev-edge-chat-jwt-secret-change-in-production
EDGE_CHAT_WEBHOOK_SECRET=docker-dev-edge-chat-webhook-secret-change-in-production
DJANGO_WEBHOOK_SECRET=docker-dev-edge-chat-webhook-secret-change-in-production
