# CycleUni 本地 Docker 開發環境變數
# 所有服務共用此檔；各服務的 docker-compose 會從此檔讀取所需變數
# =====================================================================

# ---- Django backend (CycleUni-BE) ----
SECRET_KEY=docker-dev-secret-key-change-in-production-abc123
JWT_SIGNING_KEY=docker-dev-jwt-signing-key-change-in-production
GOOGLE_BOOKS_API_KEY=dummy-google-books-api-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# PostgreSQL
POSTGRES_DATABASE=cycleuni
POSTGRES_USER=cycleuni
POSTGRES_PASSWORD=cycleuni
POSTGRES_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# CFEdgeChat integration
EDGE_CHAT_JWT_SECRET=GyHMJQPwVtEyiGSFf57KTW107AWwOMG7D6Mm3IG0zYSrcFDKoIz9RdYtGAESIKu9
# EDGE_CHAT_URL is what the Django backend returns to the frontend for the
# browser to open a WebSocket to. It must be reachable from the browser
# (use localhost / host.docker.internal here, NOT the docker-internal hostname).
EDGE_CHAT_URL=http://localhost:8787
EDGE_CHAT_WEBHOOK_SECRET=KYydbybHhHpWCDByy01xld8pjXpIB4qe6pUVOqgSPJs
EDGE_CHAT_APP_ID=cycleuni

# Google OAuth
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# Mailjet (console backend in dev)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# R2 storage (local filesystem in dev)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Default superuser
DEFAULT_SUPERUSER_EMAIL=admin@cycleuni.com
DEFAULT_SUPERUSER_PASSWORD=admin123
DEFAULT_SUPERUSER_FIRST_NAME=Admin

# Cron secret
CRON_SECRET=docker-dev-cron-secret

# ---- CycleUni-FE ----
